---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "../../components/misc/Markdown.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<MainGridLayout title={entry.data.title} description={entry.data.description} headings={headings}>
    <div class="flex flex-col gap-6 w-full">
        <!-- 顶部返回与头部卡片 -->
        <div class="card-base p-6 md:p-8 onload-animation">
            <a
                href={url("/projects/")}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-50 hover:text-[var(--primary)] transition mb-4 group"
            >
                <Icon name="material-symbols:arrow-back-rounded" class="text-base group-hover:-translate-x-1 transition duration-200" />
                <span>返回项目列表</span>
            </a>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                <div>
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-md bg-[var(--primary)]/10 text-[var(--primary)] mb-2">
                        <Icon name="material-symbols:folder-open-outline-rounded" class="text-sm" />
                        {entry.data.category}
                    </span>
                    <h1 class="text-2xl md:text-3xl font-bold text-90">{entry.data.title}</h1>
                </div>

                <!-- 快捷操作按钮 -->
                <div class="flex items-center gap-2.5 shrink-0">
                    {entry.data.repoUrl && (
                        <a
                            href={entry.data.repoUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-regular px-3.5 py-2 rounded-lg text-xs md:text-sm font-semibold flex items-center gap-2 active:scale-95 transition"
                        >
                            <Icon name="fa6-brands:github" class="text-base" />
                            <span>源码仓库</span>
                        </a>
                    )}
                    {entry.data.demoUrl && (
                        <a
                            href={entry.data.demoUrl.startsWith('/') ? url(entry.data.demoUrl) : entry.data.demoUrl}
                            target={entry.data.demoUrl.startsWith('/') ? null : "_blank"}
                            rel="noopener noreferrer"
                            class="btn-regular px-3.5 py-2 rounded-lg text-xs md:text-sm font-semibold flex items-center gap-2 active:scale-95 transition"
                        >
                            <Icon name="material-symbols:open-in-new-rounded" class="text-base" />
                            <span>在线演示</span>
                        </a>
                    )}
                </div>
            </div>

            <!-- 项目简介 -->
            <p class="text-75 text-sm md:text-base leading-relaxed mb-4">
                {entry.data.description}
            </p>

            <!-- 技术标签 -->
            <div class="flex flex-wrap gap-1.5 pt-4 border-t border-black/5 dark:border-white/5">
                {entry.data.tags.map((tag) => (
                    <span class="text-xs px-2.5 py-1 rounded-md bg-[var(--btn-regular-bg)] text-neutral-600 dark:text-neutral-300 font-mono">
                        {tag}
                    </span>
                ))}
            </div>
        </div>

        <!-- Markdown 详情正文卡片 -->
        <div class="card-base p-6 md:p-9 onload-animation">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
</MainGridLayout>
